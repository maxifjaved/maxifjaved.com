---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
}

// Vercel serves pages without trailing slashes; normalize build-time paths
// so canonical/hreflang/preload URLs match the URLs actually served.
const pagePath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const pageUrl =
  pagePath === "/"
    ? "https://maxifjaved.com/"
    : `https://maxifjaved.com${pagePath}`;

const {
  title = "Muhammad Asif Javed - AI Platform Engineer & Full-Stack Developer",
  description = "AI platform engineer & full-stack developer. Solo-architected the AI platform behind an agency serving Samsung, Reddit, Uber & Google.",
  keywords = "AI integration expert, AI platform engineer, full-stack developer, LLM integration, multi-LLM systems, WebRTC expert, real-time systems, enterprise solutions, Muhammad Asif Javed, maxifjaved, hire AI integration developer, Lahore Pakistan developer",
  ogImage = "https://maxifjaved.com/img/og-card.jpg",
  canonicalUrl = pageUrl,
  ogTitle,
  ogDescription,
  ogType = "website",
  twitterCard = "summary_large_image",
  twitterTitle,
  twitterDescription,
  twitterImage,
} = Astro.props;

// Single linked entity graph — Person is the primary entity; WebSite and
// ProfessionalService reference it by @id so AI crawlers resolve one profile,
// not competing duplicates.
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://maxifjaved.com/#person",
      "name": "Muhammad Asif Javed",
      "alternateName": "maxifjaved",
      "jobTitle": "AI Platform Engineer & Full-Stack Developer",
      "description": "AI platform engineer and full-stack developer with 10+ years of end-to-end project ownership. Solo-architected the microservices platform behind Moburst's AI marketing suite; specialist in real-time systems (WebRTC, Socket.io) and enterprise platforms.",
      "url": "https://maxifjaved.com/",
      "image": "https://maxifjaved.com/img/profile-image.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Railway Officer Colony, Walton",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "postalCode": "54000",
        "addressCountry": "PK"
      },
      "email": "axif.javed@gmail.com",
      "telephone": "+92 332 464 7331",
      "sameAs": [
        "https://github.com/maxifjaved",
        "https://www.linkedin.com/in/maxifjaved"
      ],
      "knowsAbout": [
        "AI Integration",
        "LLM Platform Engineering",
        "Microservices Architecture",
        "WebRTC Development",
        "Real-time Systems",
        "Full-Stack Development",
        "Cybersecurity Platforms",
        "Educational Technology",
        "Enterprise Software Solutions"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+92 332 464 7331",
        "contactType": "customer service",
        "areaServed": "Global",
        "availableLanguage": "en"
      },
      "makesOffer": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Integration & Full-Stack Development",
          "description": "AI platform engineering, LLM integration, real-time systems, and enterprise software built end to end by one architect"
        },
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "45",
          "priceCurrency": "USD",
          "unitText": "HOUR"
        },
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://maxifjaved.com/#website",
      "name": "Muhammad Asif Javed - AI Platform Engineer & Full-Stack Developer Portfolio",
      "url": "https://maxifjaved.com/",
      "description": "Portfolio of Muhammad Asif Javed - AI platform engineer and full-stack developer with 10+ years of solo, end-to-end platform work",
      "author": { "@id": "https://maxifjaved.com/#person" },
      "inLanguage": "en"
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://maxifjaved.com/#service",
      "name": "Muhammad Asif Javed - AI & Full-Stack Development",
      "description": "AI integration and full-stack development with 10+ years of experience. Specializing in AI platforms, real-time systems, and enterprise software delivered end to end.",
      "url": "https://maxifjaved.com/",
      "image": "https://maxifjaved.com/img/og-card.jpg",
      "founder": { "@id": "https://maxifjaved.com/#person" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Railway Officer Colony, Walton",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "postalCode": "54000",
        "addressCountry": "PK"
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": "31.5204",
          "longitude": "74.3587"
        },
        "geoRadius": "20000000"
      },
      "serviceType": "Software Development",
      "priceRange": "$$"
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Muhammad Asif Javed" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="PK-PB" />
    <meta name="geo.placename" content="Lahore, Punjab, Pakistan" />
    <meta name="geo.position" content="31.5204;74.3587" />
    <meta name="ICBM" content="31.5204, 74.3587" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- International Targeting -->
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Muhammad Asif Javed Portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={twitterTitle || ogTitle || title} />
    <meta
      property="twitter:description"
      content={twitterDescription || ogDescription || description}
    />
    <meta property="twitter:image" content={twitterImage || ogImage} />
    <meta property="twitter:creator" content="@maxifjaved" />

    <!-- Schema.org Structured Data (unified entity graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VC7TMWR4LZ"
    ></script>
    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // @ts-ignore
        dataLayer.push(arguments);
      }
      // @ts-ignore
      gtag("js", new Date());
      // @ts-ignore
      gtag("config", "G-VC7TMWR4LZ");
    </script>

    <!-- Favicons live at root paths: /img/favicon.ico is immutable-cached for
         a year, so the redesigned set must not reuse it. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload LCP images for better performance -->
    {pagePath === '/about' && (
      <link rel="preload" as="image" href="/profile-image.jpg" fetchpriority="high" />
    )}
    {pagePath.startsWith('/blogs/') && ogImage && (
      <link rel="preload" as="image" href={ogImage.replace('https://maxifjaved.com/', '/')} fetchpriority="high" />
    )}
    {(pagePath.startsWith('/blogs/') || pagePath.startsWith('/projects/')) && (
      <link rel="preload" as="image" href="/profile-image-56.jpg" imagesrcset="/profile-image-56.jpg 1x, /profile-image-112.jpg 2x" />
    )}
  </head>
  <body>
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-white focus:px-4 focus:py-2 focus:rounded">
      Skip to main content
    </a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
